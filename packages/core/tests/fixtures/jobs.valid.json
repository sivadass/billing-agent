{
  "ntfy": {
    "baseUrl": "https://ntfy.sh",
    "topicEnv": "NTFY_TOPIC",
    "priority": "default"
  },
  "mistral": {
    "apiKeyEnv": "MISTRAL_API_KEY",
    "model": "mistral-small-latest"
  },
  "browser": {
    "headless": true,
    "timeoutMs": 60000,
    "saveErrorScreenshot": true
  },
  "jobs": [
    {
      "id": "home-eb",
      "userId": "user-1",
      "provider": "tnpdcl",
      "enabled": true,
      "schedule": "0 9 * * *",
      "credentials": {
        "usernameEnv": "TNPDCL_USERNAME",
        "passwordEnv": "TNPDCL_PASSWORD"
      },
      "notify": { "title": "TNPDCL Bill" }
    },
    {
      "id": "smoke-test",
      "userId": "user-1",
      "provider": "dummy",
      "enabled": true,
      "schedule": null,
      "credentials": {},
      "notify": { "title": "Dummy Bill" }
    }
  ]
}
