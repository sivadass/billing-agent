MONGODB_URI=mongodb://127.0.0.1:27017/billing_agent
JWT_SECRET=replace-with-strong-random-secret
SECRETS_MASTER_KEY=
HTTP_PORT=8080
CORS_ORIGINS=http://localhost:5173,https://your-app.vercel.app
NTFY_TOPIC=your-secret-topic
MISTRAL_API_KEY=your-mistral-api-key
TNPDCL_USERNAME=
TNPDCL_PASSWORD=

# --- Backblaze B2 (S3-compatible, private bucket) ---
# Same names as notepad/api. Aliases: B2_KEY_ID, B2_APPLICATION_KEY, B2_BUCKET.
# Chat and run screenshots upload worker → B2; the API returns presigned GET URLs.
B2_ACCESS_KEY_ID=
B2_SECRET_ACCESS_KEY=
B2_BUCKET_NAME=
B2_ENDPOINT=https://s3.us-east-005.backblazeb2.com
B2_PRESIGNED_EXPIRES_SECONDS=3600

