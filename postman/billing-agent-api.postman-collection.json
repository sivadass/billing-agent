{
  "info": {
    "_postman_id": "b7d5f6e9-9fb7-4d21-87b6-9538fd0b92ec",
    "name": "billing-agent-api",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{apiToken}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "apiToken",
      "value": "replace-with-api-token"
    },
    {
      "key": "jobId",
      "value": "smoke-test"
    },
    {
      "key": "runId",
      "value": "replace-with-run-id"
    }
  ],
  "item": [
    {
      "name": "Health",
      "request": {
        "auth": {
          "type": "noauth"
        },
        "method": "GET",
        "url": "{{baseUrl}}/health"
      }
    },
    {
      "name": "Runs",
      "item": [
        {
          "name": "List Runs",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/runs"
          }
        },
        {
          "name": "List Runs By Job",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/runs?jobId={{jobId}}&limit=20"
          }
        },
        {
          "name": "Get Run By Id",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/runs/{{runId}}"
          }
        }
      ]
    },
    {
      "name": "Jobs",
      "item": [
        {
          "name": "List Jobs",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/jobs"
          }
        },
        {
          "name": "Get Job By Id",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/jobs/{{jobId}}"
          }
        },
        {
          "name": "Run Job Now",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/jobs/{{jobId}}/run"
          }
        },
        {
          "name": "Create Job (adapter)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": \"smoke-test\",\n  \"name\": \"Dummy Bill\",\n  \"engine\": \"adapter\",\n  \"adapterId\": \"dummy\",\n  \"enabled\": true,\n  \"schedule\": null,\n  \"notify\": {\n    \"title\": \"Dummy Bill\",\n    \"on\": \"always\",\n    \"channel\": { \"type\": \"ntfy\", \"topic\": \"bills\" }\n  }\n}"
            },
            "url": "{{baseUrl}}/jobs",
            "description": "Canonical create. `provider` is still accepted as an alias for `adapterId`, but responses only ever use the canonical fields."
          }
        },
        {
          "name": "Create Job (workflow)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": \"shoe-price\",\n  \"name\": \"Shoe price\",\n  \"engine\": \"workflow\",\n  \"startUrl\": \"https://sivadass.in/\",\n  \"goal\": \"Read the listed price\",\n  \"schema\": [{ \"name\": \"price\", \"type\": \"number\" }],\n  \"workflow\": [{ \"id\": \"open\", \"type\": \"goto\", \"url\": \"https://sivadass.in/\" }],\n  \"notify\": { \"title\": \"Shoe price\" }\n}"
            },
            "url": "{{baseUrl}}/jobs",
            "description": "A workflow job must supply a public http(s) `startUrl`."
          }
        },
        {
          "name": "Patch Job",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"enabled\": false,\n  \"notify\": { \"title\": \"Dummy Bill Updated\" }\n}"
            },
            "url": "{{baseUrl}}/jobs/{{jobId}}"
          }
        },
        {
          "name": "Soft Delete Job",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/jobs/{{jobId}}"
          }
        },
        {
          "name": "List Job Secret Keys",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/jobs/{{jobId}}/secrets",
            "description": "Returns key names only: {\"keys\":[{\"key\":\"TNPDCL_PASSWORD\",\"set\":true}]}. Stored values are never returned."
          }
        },
        {
          "name": "Set Job Secrets",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"values\": {\n    \"TNPDCL_PASSWORD\": \"new-password\"\n  }\n}"
            },
            "url": "{{baseUrl}}/jobs/{{jobId}}/secrets",
            "description": "Write-only. Values are encrypted with SECRETS_MASTER_KEY; an omitted key keeps its stored value and a re-sent key is re-encrypted in place. Returns 409 while that job has a run in flight."
          }
        }
      ]
    }
  ]
}
